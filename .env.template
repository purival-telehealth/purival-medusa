# ── Core wiring (set automatically by the Railway template) ─────────────────
# Postgres connection is supplied by Railway.
DATABASE_URL=postgres://postgres:password@postgres.railway.internal:5432/railway
# Redis connection is supplied by Railway; family=0 is appended automatically.
REDIS_URL=redis://redis.railway.internal:6379

# shared = one service does everything (dev/simple deploys)
# server = serves API + admin; worker = background jobs
MEDUSA_WORKER_MODE=server
PORT=9000

# ── Secrets — generate strong random values in production ────────────────────
JWT_SECRET=
COOKIE_SECRET=

# ── URLs / CORS ──────────────────────────────────────────────────────────────
MEDUSA_BACKEND_URL=https://your-app.up.railway.app
ADMIN_CORS=https://your-app.up.railway.app
STORE_CORS=http://localhost:3000,https://your-storefront.up.railway.app
AUTH_CORS=https://your-app.up.railway.app,http://localhost:3000

# ── Admin dashboard ──────────────────────────────────────────────────────────
DISABLE_MEDUSA_ADMIN=false
# MEDUSA_ADMIN_EMAIL=admin@example.com
MEDUSA_ADMIN_PASSWORD=

# ── Product media (Cloudflare R2, S3-compatible) ──────────────────────────────
S3_BUCKET=purival-product-media
S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PREFIX=products/
S3_FILE_URL=https://media.purival.com

# ── Boot behavior ────────────────────────────────────────────────────────────
# Run migrations on the server before serving; the worker should skip them.
MIGRATE_ON_BOOT=true

